# Qdrant Cloud cluster
QDRANT_URL=https://your-cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key

# Generator, as "provider:model" for langchain's init_chat_model. Default is Anthropic;
# for Vertex use google_vertexai:gemini-2.5-flash with `uv sync --extra vertex` and
# `gcloud auth application-default login`.
GENERATOR_MODEL=anthropic:claude-haiku-4-5
ANTHROPIC_API_KEY=your-anthropic-api-key

# Future AGI platform (tracing + evals)
FI_API_KEY=your-fi-api-key
FI_SECRET_KEY=your-fi-secret-key

# Where live traffic (app + notebook asks) traces to. The five scored stage projects are
# written only by `run_golden.py --stage iterN`, which overrides this per stage — so live
# questions during the session can never touch the frozen scored runs.
FI_PROJECT_NAME=pokedex-webinar-live
