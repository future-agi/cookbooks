# Future AGI: traces for every run, and the cloud evals (make eval-cloud).
# Keys: app.futureagi.com > Settings > API keys
FI_API_KEY=
FI_SECRET_KEY=
FI_PROJECT_NAME=llm-spend-watchdog

# The model that writes the Slack message. Any LiteLLM model id works.
# Leave the key empty to use the built-in template instead.
LLM_MODEL=anthropic/claude-haiku-5-5
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Slack incoming webhook. Only used with --approve, after you type y.
SLACK_WEBHOOK_URL=

# The budget sheet: each tab published as CSV (File > Share > Publish to web).
# Empty: read data/sample/keys.csv, budgets.csv and balances.csv.
KEYS_SHEET_CSV_URL=
BUDGETS_SHEET_CSV_URL=
BALANCES_SHEET_CSV_URL=

# Alerting rules
THRESHOLDS=0.5,0.8,1.0
RUNOUT_WARN_HOURS=72
PERSIST_READS=3
